# ============================================
# MindBuddy + pi-agent runtime configuration
# ============================================

# 可选: 默认提供商（也可在 WebUI 中每次请求指定）
# qwen | zhipu | deepseek | openai | openai-compat
LLM_PROVIDER=

# 可选: 默认模型 ID（不再提供厂商推荐默认值）
# 建议在 WebUI 中由用户自行填写/切换
LLM_MODEL=
# 可选: 单次请求超时毫秒（默认 45000）
LLM_TIMEOUT_MS=45000

# 可选: Soul 配置文件路径（默认项目根目录 soul.md）
SOUL_PATH=soul.md

# --------------------------------------------
# Qwen (OpenAI-compatible)
# --------------------------------------------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --------------------------------------------
# Zhipu GLM (OpenAI-compatible)
# --------------------------------------------
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --------------------------------------------
# DeepSeek (OpenAI-compatible)
# --------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --------------------------------------------
# OpenAI native
# --------------------------------------------
OPENAI_API_KEY=

# --------------------------------------------
# OpenAI 兼容网关（需同时设置 OPENAI_API_KEY + OPENAI_BASE_URL）
# 当使用兼容网关时，建议 LLM_PROVIDER=openai-compat
# --------------------------------------------
OPENAI_BASE_URL=

# 服务端口
PORT=3000

# 可选: WebSocket 通道
WS_ENABLED=0
WS_PORT=3001
